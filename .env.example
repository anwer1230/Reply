# APP_URL: The URL where this applet is hosted (e.g. https://autoreply.onrender.com or dev URL)
APP_URL="http://localhost:3000"

# Port to listen on (Render automatically provides PORT=10000 or 3000)
PORT=3000

# Telegram Bot Token (from @BotFather on Telegram)
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=""

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_VERIFY_TOKEN="autoreply_secret_token_123"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
